APP_NAME="Evaluación Hospital de Simulación"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://evaluacion.example.edu.ec
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evaluacion_hsimulacion
DB_USERNAME=evaluacion_app
DB_PASSWORD=CAMBIAR_CON_SECRETO_SEGURO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=evaluacion.example.edu.ec

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.edu.ec
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@example.edu.ec
MAIL_FROM_NAME="${APP_NAME}"
