[Unit]
Description=Laravel scheduler - Evaluación Hospital
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/evaluacion-hospital
ExecStart=/opt/remi/php83/root/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
