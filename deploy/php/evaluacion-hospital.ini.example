; Con Remi PHP 8.3, copiar a:
; /etc/opt/remi/php83/php.d/99-evaluacion-hospital.ini
expose_php = Off
memory_limit = 512M
max_execution_time = 120
max_input_time = 120

; Deben ser iguales o superiores al máximo configurable en la aplicación.
upload_max_filesize = 50M
post_max_size = 1024M
max_file_uploads = 20

session.cookie_httponly = On
session.cookie_secure = On
session.cookie_samesite = Lax
